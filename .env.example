# TMDB API key (v3 auth) — used by /api/tmdb/* (search + metadata) when saving
# titles from /manage. The public /films page reads snapshots from PocketBase
# and needs no key.
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Spotify — powers the live /music page (top tracks & artists).
# Create an app at https://developer.spotify.com/dashboard, then run
# `node scripts/spotify-auth.ts` to obtain the refresh token.
# In production these must be set as Cloudflare Pages environment variables.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
